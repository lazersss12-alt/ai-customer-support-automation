      "typeVersion": 1,
      "position": [
        2160,
        780
      ],
      "name": "OpenRouter Chat Model",
      "id": "b2c3d4e5-0013-4000-8000-000000000013",
      "credentials": {
        "openRouterApi": {
          "id": "UNYCbMfrqR2jHeEv",
          "name": "OpenRouter (free tier)"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"answer\": { \"type\": \"string\" },\n    \"status\": { \"type\": \"string\", \"enum\": [\"resolved\", \"needs_human\", \"unknown\"] },\n    \"confidence\": { \"type\": \"number\" },\n    \"needs_human\": { \"type\": \"boolean\" },\n    \"reason\": { \"type\": [\"string\", \"null\"] }\n  },\n  \"required\": [\"answer\", \"status\", \"confidence\", \"needs_human\", \"reason\"]\n}"
      },
